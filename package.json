{
  "name": "reagent-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api,worker -c blue,green,magenta \"vite\" \"npm run api\" \"npm run worker\"",
    "app:start": "./scripts/dev.sh start",
    "app:stop": "./scripts/dev.sh stop",
    "app:restart": "./scripts/dev.sh restart",
    "app:status": "./scripts/dev.sh status",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "web": "vite",
    "api": "node --env-file-if-exists=.env --env-file-if-exists=ports.env --import tsx --watch backend/src/server.ts",
    "worker": "node --env-file-if-exists=.env --env-file-if-exists=ports.env --import tsx --watch backend/src/worker.ts",
    "start": "cross-env NODE_ENV=production node --env-file-if-exists=.env --env-file-if-exists=ports.env --import tsx backend/src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@ai-sdk/react": "^4.0.20",
    "@blocknote/core": "^0.19.1",
    "@blocknote/mantine": "^0.19.1",
    "@blocknote/react": "^0.19.1",
    "@composio/core": "^0.14.0",
    "@cyntler/react-doc-viewer": "^1.16.1",
    "@hono/node-server": "^2.0.8",
    "@mantine/core": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^7.0.19",
    "better-sqlite3": "^12.11.1",
    "bullmq": "^5.80.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.9.3",
    "gsap": "^3.15.0",
    "hono": "^4.12.28",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.23.0",
    "motion": "^12.43.0",
    "nanoid": "^5.1.16",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unpdf": "^1.6.2",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  }
}
