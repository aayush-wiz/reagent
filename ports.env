# ============================================================================
# Reagent — FIXED PORTS (single source of truth).
#
# Sourced by scripts/dev.sh (start/stop/restart) AND loaded by node
# (--env-file ports.env) and vite (via the exported env). Change a port here and
# the whole app + the scripts follow. Never let a process pick a random port.
# ============================================================================

# Frontend (Vite dev server)
WEB_PORT=5173

# Backend API (Hono)
API_PORT=8181

# Docs site (Blume/Astro dev server — the landing "Docs" button opens this)
DOCS_PORT=4337

# Redis (BullMQ broker + run pub/sub)
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# Per-research sandbox services (reserved range: 8200–8249).
SANDBOX_PORT_BASE=8200
SANDBOX_PORT_COUNT=50
