# Reagent — LLM provider config. Copy this file to `.env` and fill in your own keys.
# Default model runs on Databricks; other dropdown models run on OpenRouter.

# Databricks model serving (OpenAI-compatible) — powers "Claude Sonnet 4.6".
DATABRICKS_TOKEN=
DATABRICKS_HOST=
DATABRICKS_MODEL=

# OpenRouter — powers the other (open) models in the dropdown.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=

# Enable the compute workspace (bash / run_python) for COMPUTE + ANALYZE stages.
REAGENT_ENABLE_EXEC=true

# Subagents run on a cheap/fast OpenRouter model (off Databricks, avoids its rate limit).
REAGENT_SUBAGENT_MODEL=

# Exa web search (exa-search skill) — general-web / analyst research.
EXA_API_KEY=
